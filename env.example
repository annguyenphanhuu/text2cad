# Copy to .env and fill in real values. NEVER commit .env.

# ---------- Server ----------
UVICORN_PORT=8080
UVICORN_WORKERS=1
DOMAIN=http://localhost
BASE_URL=http://localhost
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_FLOW_LOGGING=false
ENABLE_VERBOSE_LOGGING=false

# ---------- Database (MySQL) ----------
# Required. src/api/main.py calls init_db() at import time and the process
# exits if MySQL is unreachable - there is no sqlite fallback, and the
# SKIP_DB_CONNECTION variable some .env files carry is read by nothing.
# For local dev: docker compose -f docker-compose.local.yml up -d
# (that publishes MySQL on 3307, so use MYSQL_HOST=127.0.0.1 MYSQL_PORT=3307)
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=your_database
MYSQL_USER=your_username        # must not be root
MYSQL_PASSWORD=your_password
MYSQL_HOST=db
MYSQL_PORT=3306

# ---------- LLM providers ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ---------- Auth ----------
API_SECRET_TOKEN=your_secret_token

# ---------- FreeCAD execution backend ----------
# Remote FreeCAD microservice base URL (exposes /health, /freecad/generate,
# /freecad/status/<user_id>, /freecad/result/<user_id>, /freecad/download/<user_id>/<file>)
server_freecad=http://localhost:8020

# MQTT broker used by the FreeCAD server to publish job progress/status
# Topics: freecad/progress/<user_id>, freecad/status/<user_id>
MQTT_BROKER=mqtt://localhost:1883
MQTT_CLIENT_ID=tolery_api_ai_listener
MQTT_QOS=1
MQTT_KEEPALIVE=60
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------- Tuning ----------
FEATURE_ENRICHMENT_TIMEOUT_SECONDS=120
SUPPRESS_MONITOR_ACCESS_LOGS=true

# CAD pipeline: "ir" (default, LLM extracts a part IR -> deterministic FreeCAD builder) or "legacy" (per-shape code generation)
CAD_PIPELINE=ir
